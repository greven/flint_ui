@doc """
Renders a styled navbar.

Generated by `mix flint.add navbar`. Theming lives in `flint.css`; this wrapper
adds the `data-navbar` presence hook the styled layer targets and forwards the
navigation items. Headless behavior comes from `FlintUI.navbar`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.navbar data-navbar class={@class} {@rest}>
    {render_slot(@inner_block)}
  </FlintUI.navbar>
  """
end
