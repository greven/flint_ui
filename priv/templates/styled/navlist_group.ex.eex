@doc """
Renders a styled navlist group.

Generated by `mix flint.add navlist_group`. Theming lives in `flint.css`; this
wrapper adds the `data-navlist_group` marker the theme targets, renders the
optional leading and trailing icons in the header, and forwards a custom
indicator. The default slot is the group's items. Headless static and
collapsible behavior comes from `FlintUI.navlist_group`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.navlist_group data-navlist_group class={@class} {@rest}>
    <:leading>
      {render_slot(@leading)}
      <FlintUI.icon :if={@icon} name={@icon} />
    </:leading>
    <:trailing>
      {render_slot(@trailing)}
      <FlintUI.icon :if={@trailing_icon} name={@trailing_icon} />
    </:trailing>
    <:indicator :for={indicator <- @indicator} {Map.drop(indicator, [:inner_block, :__slot__])}>
      {render_slot(indicator)}
    </:indicator>
    {render_slot(@inner_block)}
  </FlintUI.navlist_group>
  """
end
