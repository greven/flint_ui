@doc """
Renders a styled flag.

Generated by `mix flint.add flag`. Theming lives in `flint.css`; this wrapper
maps the `size`, `radius`, `overlay`, `border`, and `shadow` attributes onto the
matching `data-*` hooks the theme targets. Headless semantics come from
`FlintUI.flag`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.flag
    data-flag
    data-size={@size}
    data-radius={@radius}
    data-overlay={@overlay}
    data-border={@border}
    data-shadow={@shadow}
    class={@class}
    {@rest}
  />
  """
end
