@doc """
Renders a styled flag.

Generated by `mix flint.add flag`. Theming lives in `flint.css`; this wrapper
maps the `size`, `radius`, `overlay`, `border`, and `shadow` attributes onto the
matching `data-*` hooks the theme targets, and forwards `code`, `shape`, and
`label` to the headless component. The headless component loads the copied SVG
from the configured flag path, so `code` can be dynamic. Headless semantics come
from `FlintUI.flag`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    assigns
    |> assign(:data_size, FlintUI.Styled.Size.scale(assigns.size))
    |> assign(
      :rest,
      FlintUI.Styled.Size.put_style(
        assigns.rest,
        FlintUI.Styled.Size.style(assigns.size, "--fl-flag-size")
      )
    )

  ~H"""
  <FlintUI.flag
    data-flag
    data-size={@data_size}
    data-radius={@radius}
    data-overlay={@overlay}
    data-border={@border}
    data-shadow={@shadow}
    class={@class}
    {@rest}
  />
  """
end
