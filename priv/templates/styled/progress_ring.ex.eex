@doc """
Renders a styled progress ring.

Generated by `mix flint.add progress_ring`. Theming lives in `flint.css`; this
wrapper maps `size`, `thickness`, `color`, and `indeterminate` onto the ring
root, writes a raw color to the root's CSS inputs, and forwards `value`, `max`,
`label`, `show_status`, and the rest of the `FlintUI.progress_ring` contract. A
caller `style` also lands on the root. Headless behavior comes from
`FlintUI.progress_ring`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    FlintUI.Styled.Color.apply_style(
      assigns,
      ~w(neutral info success warning error primary secondary),
      fill: "--fl-progress-ring-color"
    )

  {rest_style, rest} = Map.pop(assigns.rest, :style)

  style =
    [assigns.color_style, rest_style]
    |> Enum.reject(&(&1 in [nil, ""]))
    |> Enum.join("; ")

  root_attrs =
    %{
      "data-progress_ring" => true,
      "data-size" => assigns.size,
      "data-thickness" => assigns.thickness,
      "data-color" => assigns.data_color,
      "data-indeterminate" => assigns.indeterminate,
      "style" => style
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false or value == "" end)
    |> Map.new()

  assigns =
    assigns
    |> assign(:root_attrs, root_attrs)
    |> assign(:rest, rest)

  ~H"""
  <FlintUI.progress_ring root_attrs={@root_attrs} class={@class} {@rest} />
  """
end
