@doc """
Renders a styled toggle.

Generated by `mix flint.add toggle`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `dashed`, `color`, `size`, `radius`, `pill`, and `depth`
attributes onto the matching `data-*` hooks the theme targets. Headless behavior
comes from `FlintUI.toggle`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  ~H"""
  <FlintUI.toggle
    data-toggle
    data-variant={@variant}
    data-dashed={@dashed}
    data-color={@data_color}
    data-size={@size}
    data-radius={@radius}
    data-pill={@pill}
    data-depth={@depth}
    class={@class}
    {@rest}
  >
    {render_slot(@leading)}
    {render_slot(@inner_block)}
    {render_slot(@trailing)}
  </FlintUI.toggle>
  """
end
