@doc """
Renders a styled toggle.

Generated by `mix flint.add toggle`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `active_variant`, `dashed`, `color`, `active_color`, `size`,
`radius`, `pill`, `square`, `wide`, `justify`, `depth`, and `inset` attributes
onto the matching `data-*` hooks the theme targets. `variant` and `color` style
the untoggled control, `active_variant` and `active_color` the toggled one, and
`inherit` follows the untoggled value. `icon` and `text` are content shortcuts;
the default slot wins over `text`. The `:on` and `:off` slots render content that
is only visible in that state. Headless behavior comes from `FlintUI.toggle`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  ~H"""
  <FlintUI.toggle
    data-toggle
    data-variant={@variant}
    data-active-variant={if @active_variant == "inherit", do: @variant, else: @active_variant}
    data-dashed={@dashed}
    data-color={@data_color}
    data-active-color={@data_active_color}
    data-size={@size}
    data-radius={@radius}
    data-pill={@pill}
    data-square={@square}
    data-wide={@wide}
    data-justify={@justify}
    data-depth={@depth}
    data-inset={@inset}
    class={@class}
    {@rest}
  >
    {render_slot(@leading)}
    <FlintUI.icon :if={@icon} name={@icon} />
    <span :if={@on != []} data-part="on-state">{render_slot(@on)}</span>
    <span :if={@off != []} data-part="off-state">{render_slot(@off)}</span>
    {render_slot(@inner_block) || @text}
    {render_slot(@trailing)}
  </FlintUI.toggle>
  """
end
