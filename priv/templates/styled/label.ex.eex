@doc """
Renders a styled label.

Generated by `mix flint.add label`. Theming lives in `flint.css`; this wrapper
maps `size` onto the label root and forwards `for`, `label`, `sublabel`,
`required`, `description`, and the rest of the `FlintUI.label` contract. Headless
behavior comes from `FlintUI.label`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  root_attrs =
    %{
      "data-label" => true,
      "data-size" => assigns.size
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) end)
    |> Map.new()

  assigns = assign(assigns, :root_attrs, root_attrs)

  ~H"""
  <FlintUI.label
    root_attrs={@root_attrs}
    label_content={@inner_block not in [nil, []] && render_slot(@inner_block)}
    class={@class}
    {@rest}
  />
  """
end
