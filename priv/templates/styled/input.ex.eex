@doc """
Renders a styled input.

Generated by `mix flint.add input`. Theming lives in `flint.css`; this wrapper
maps `size` and `radius` onto the field root, forwards a numeric `size` to the
native control, and forwards the rest of the `FlintUI.input` contract, including
`field`, `type`, `options`, `errors`, and the inner and outer prefix and suffix
slots. Headless behavior comes from `FlintUI.input`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns = assign(assigns, :data_size, FlintUI.Styled.Size.scale(assigns.size))

  # A numeric size is the native HTML attribute, not a control scale.
  rest =
    if assigns.data_size do
      assigns.rest
    else
      Map.put(assigns.rest, :size, assigns.size)
    end

  root_attrs =
    %{
      "data-input" => true,
      "data-size" => assigns.data_size,
      "data-radius" => assigns.radius
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) end)
    |> Map.new()

  assigns =
    assigns
    |> assign(:root_attrs, root_attrs)
    |> assign(:rest, rest)

  ~H"""
  <FlintUI.input root_attrs={@root_attrs} class={@class} {@rest}>
    <:inner_prefix>{render_slot(@inner_prefix)}</:inner_prefix>
    <:inner_suffix>{render_slot(@inner_suffix)}</:inner_suffix>
    <:outer_prefix>{render_slot(@outer_prefix)}</:outer_prefix>
    <:outer_suffix>{render_slot(@outer_suffix)}</:outer_suffix>
  </FlintUI.input>
  """
end
