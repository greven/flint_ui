@doc """
Renders a styled avatar group.

Generated by `mix flint.add avatar_group`. Theming lives in `flint.css`; this
wrapper maps `size`, `overlap`, and `ring` onto the matching `data-*` hooks and
forwards the root element and its attributes. Headless structure comes from
`FlintUI.avatar_group`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.avatar_group
    data-avatar_group
    data-size={@size}
    data-overlap={@overlap}
    data-ring={@ring}
    class={@class}
    {@rest}
  >
    {render_slot(@inner_block)}
  </FlintUI.avatar_group>
  """
end
