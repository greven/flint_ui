@doc """
Renders a styled breadcrumb item.

Generated by `mix flint.add breadcrumbs_item`. Theming lives in `flint.css`;
this wrapper maps `separator` onto the `data-separator` hook the theme targets,
adds the `data-breadcrumbs_item` marker, and renders `icon` before the content.
`text` fills in when the default slot is empty. Headless link and current-page
behavior comes from `FlintUI.breadcrumbs_item`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.breadcrumbs_item
    data-breadcrumbs_item
    data-separator={@separator}
    class={@class}
    {@rest}
  >
    <FlintUI.icon :if={@icon} name={@icon} />
    {render_slot(@inner_block) || @text}
  </FlintUI.breadcrumbs_item>
  """
end
