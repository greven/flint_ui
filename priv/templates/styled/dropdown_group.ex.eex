@doc """
Renders a styled dropdown group.

Generated by `mix flint.add dropdown_group`. Theming lives in `flint.css`; this
wrapper adds the `data-dropdown_group` marker the theme targets. Headless
behavior comes from `FlintUI.dropdown_group`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.dropdown_group data-dropdown_group class={@class} {@rest}>
    {render_slot(@inner_block)}
  </FlintUI.dropdown_group>
  """
end
