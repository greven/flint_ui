@doc """
Renders a styled navbar menu.

Generated by `mix flint.add navbar_menu`. Theming lives in `flint.css`; this
wrapper adds the `data-navbar_menu` marker the theme targets, renders the
optional leading and trailing icons in the trigger, and forwards a custom
indicator. The default slot is the menu content. Headless disclosure behavior
comes from `FlintUI.navbar_menu`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.navbar_menu data-navbar_menu class={@class} {@rest}>
    <:leading>
      {render_slot(@leading)}
      <FlintUI.icon :if={@icon} name={@icon} />
    </:leading>
    <:trailing>
      {render_slot(@trailing)}
      <FlintUI.icon :if={@trailing_icon} name={@trailing_icon} />
    </:trailing>
    <:indicator :for={indicator <- @indicator} {Map.drop(indicator, [:inner_block, :__slot__])}>
      {render_slot(indicator)}
    </:indicator>
    {render_slot(@inner_block)}
  </FlintUI.navbar_menu>
  """
end
