@doc """
Renders a styled alert.

Generated by `mix flint.add alert`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `color`, `spacing`, `shadow`, `border`, and `background`
attributes onto the matching `data-*` hooks the theme targets, and forwards the headless
attributes, including `intent`, `title`, `orientation`, and `with_close`.
`show_icon` keeps the intent color while hiding its default icon; an explicit
`:icon` slot always renders. Headless behavior comes from `FlintUI.alert`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  intent = Map.get(assigns.rest, :intent)
  assigns = assign(assigns, :color, assigns.color || intent || "neutral")

<%= @color %>
  intent_icon =
    if assigns.icon == [] and assigns.show_icon do
      FlintUI.Base.Alert.intent_icon(intent)
    end

  assigns = assign(assigns, :intent_icon, intent_icon)

  ~H"""
  <FlintUI.alert
    data-alert
    data-variant={@variant}
    data-color={@data_color}
    data-spacing={@spacing}
    data-shadow={@shadow}
    data-border={@border}
    data-background={@background}
    class={@class}
    {@rest}
  >
    <:icon :if={@icon != []}>{render_slot(@icon)}</:icon>
    <:icon :if={@intent_icon}>
      <FlintUI.icon name={@intent_icon} />
    </:icon>
    <:actions>{render_slot(@actions)}</:actions>
    <:close>
      {render_slot(@close)}
      <FlintUI.icon :if={@close == []} name="lucide-x" />
    </:close>
    {render_slot(@inner_block)}
  </FlintUI.alert>
  """
end
