@doc """
Renders a styled indicator.

Generated by `mix flint.add indicator`. Theming lives in `flint.css`; this
wrapper maps `position`, `inset`, `ring`, and `attention` onto the indicator
root, `offset` onto its CSS input, and the nested badge's `variant`, `color`,
and `size` onto the badge, which always renders as a pill. `label`,
`badge_label`, and `status` describe the badge. Headless behavior comes from
`FlintUI.indicator`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  badge_attrs =
    %{
      "data-badge" => true,
      "data-variant" => assigns.variant,
      "data-color" => assigns.data_color,
      "data-size" => assigns.size,
      "data-pill" => true
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) end)
    |> Map.new()

  {rest_style, rest} = Map.pop(assigns.rest, :style)

  offset_style =
    if assigns.offset not in [nil, 0],
      do: "--fl-indicator-offset: #{assigns.offset}px"

  style =
    [offset_style, rest_style]
    |> Enum.reject(&is_nil/1)
    |> Enum.map_join("; ", fn
      value when is_list(value) -> Enum.map_join(value, "; ", &IO.iodata_to_binary/1)
      value -> IO.iodata_to_binary(value)
    end)

  assigns =
    assigns
    |> assign(:badge_attrs, badge_attrs)
    |> assign(:rest, rest)
    |> assign(:style, if(style == "", do: nil, else: style))

  ~H"""
  <FlintUI.indicator
    data-indicator
    data-position={@position}
    data-inset={@inset}
    data-ring={@ring}
    data-attention={@attention != "none" && @attention}
    class={@class}
    style={@style}
    {@rest}
    badge_attrs={@badge_attrs}
  >
    {render_slot(@inner_block)}
  </FlintUI.indicator>
  """
end
