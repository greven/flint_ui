@doc """
Renders a styled indicator.

Generated by `mix flint.add indicator`. Theming lives in `flint.css`; this
wrapper maps `position`, `inset`, and `ring` onto the indicator root and the
nested badge's `variant`, `color`, `size`, and `radius` onto the badge. `label`,
`badge_label`, and `status` describe the badge. Headless behavior comes from
`FlintUI.indicator`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  badge_attrs =
    %{
      "data-badge" => true,
      "data-variant" => assigns.variant,
      "data-color" => assigns.data_color,
      "data-size" => assigns.size,
      "data-radius" => assigns.radius
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) end)
    |> Map.new()

  assigns = assign(assigns, :badge_attrs, badge_attrs)

  ~H"""
  <FlintUI.indicator
    data-indicator
    data-position={@position}
    data-inset={@inset}
    data-ring={@ring}
    class={@class}
    {@rest}
    badge_attrs={@badge_attrs}
  >
    {render_slot(@inner_block)}
  </FlintUI.indicator>
  """
end
