@doc """
Renders a styled dropdown header.

Generated by `mix flint.add dropdown_header`. Theming lives in `flint.css`;
this wrapper adds the `data-dropdown_header` marker the theme targets. Headless
behavior comes from `FlintUI.dropdown_header`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.dropdown_header data-dropdown_header class={@class} {@rest}>
    {render_slot(@inner_block)}
  </FlintUI.dropdown_header>
  """
end
