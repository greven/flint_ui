@doc """
Renders a styled navlist.

Generated by `mix flint.add navlist`. Theming lives in `flint.css`; this wrapper
adds the `data-navlist` presence hook and maps `rail` onto the `data-rail` hook
the theme targets. Headless behavior comes from `FlintUI.navlist`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.navlist data-navlist data-rail={@rail} class={@class} {@rest}>
    {render_slot(@inner_block)}
  </FlintUI.navlist>
  """
end
