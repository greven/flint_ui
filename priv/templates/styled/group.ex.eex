@doc """
Renders a styled group.

Generated by `mix flint.add group`. Theming lives in `flint.css`; this wrapper
maps the `attached`, `surface`, and `size` attributes onto the `data-attached`,
`data-surface`, and `data-size` hooks the theme targets. `surface` is omitted
for the default `none`, so the theme reads any surface hook as a shell. Headless
structure comes from `FlintUI.group`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.group
    data-group
    data-attached={@attached}
    data-surface={if @surface == "none", do: nil, else: @surface}
    data-size={@size}
    class={@class}
    {@rest}
  >
    {render_slot(@inner_block)}
  </FlintUI.group>
  """
end
