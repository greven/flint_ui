@doc """
Renders a styled group.

Generated by `mix flint.add group`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `surface`, and `size` attributes onto the `data-variant`,
`data-surface`, and `data-size` hooks the theme targets. Headless structure comes
from `FlintUI.group`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.group
    data-group
    data-variant={@variant}
    data-surface={@surface}
    data-size={@size}
    class={@class}
    {@rest}
  >
    {render_slot(@inner_block)}
  </FlintUI.group>
  """
end
