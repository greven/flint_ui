@doc """
Renders a styled modal.

Generated by `mix flint.add modal`. Theming lives in `flint.css`; this wrapper
maps the `size`, `placement`, and `backdrop` attributes onto the dialog shell,
and the card's `body` and `spacing` attributes onto the surface, which is a
nested card. The card opts into the shared elevation at the top of the ladder,
so its trim and depth follow `--fl-elevation-*`. It forwards the headless
attributes, including `id`, `opened`, `role`, the dismissal options, and the
server events. Headless behavior comes from `FlintUI.modal`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.modal
    data-modal
    data-size={@size}
    data-placement={@placement}
    data-backdrop={@backdrop}
    class={@class}
    card_attrs={%{
      "data-card" => true,
      "data-elevation" => true,
      "data-outline" => true,
      "data-shadow" => true,
      "data-body" => @body,
      "data-spacing" => @spacing
    }}
    {@rest}
  >
    <:title :if={@title not in [nil, []]}>{render_slot(@title)}</:title>
    <:description :if={@description not in [nil, []]}>{render_slot(@description)}</:description>
    <:footer :if={@footer not in [nil, []]}>{render_slot(@footer)}</:footer>
    <:close>
      {render_slot(@close)}
      <FlintUI.icon :if={@close in [nil, []]} name="lucide-x" />
    </:close>
    {render_slot(@inner_block)}
  </FlintUI.modal>
  """
end
