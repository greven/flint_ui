@doc """
Renders a styled button.

Generated by `mix flint.add button`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `color`, `size`, `radius`, `pill`, `square`, `wide`,
`justify`, `depth`, and `inset` attributes onto the matching `data-*` hooks the
theme targets. `icon` and `text` are
content shortcuts; the default slot wins over `text`. Headless behavior comes
from `FlintUI.button`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  ~H"""
  <FlintUI.button
    data-button
    data-variant={@variant}
    data-color={@data_color}
    data-size={@size}
    data-radius={@radius}
    data-pill={@pill}
    data-square={@square}
    data-wide={@wide}
    data-justify={@justify}
    data-depth={@depth}
    data-inset={@inset}
    class={@class}
    {@rest}
  >
    {render_slot(@leading)}
    <FlintUI.icon :if={@icon} name={@icon} />
    {render_slot(@inner_block) || @text}
    {render_slot(@trailing)}
  </FlintUI.button>
  """
end
