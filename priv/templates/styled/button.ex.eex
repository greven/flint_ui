@doc """
Renders a styled button.

Generated by `mix flint.add button`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `color`, `size`, and `depth` attributes onto the
`data-variant`, `data-color`, `data-size`, and `data-depth` hooks the theme
targets. Headless behavior comes from `FlintUI.button`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.button
    data-button
    data-variant={@variant}
    data-color={@color}
    data-size={@size}
    data-depth={to_string(@depth)}
    class={@class}
    {@rest}
  >
    {render_slot(@leading)}
    {render_slot(@inner_block)}
    {render_slot(@trailing)}
  </FlintUI.button>
  """
end
