@doc """
Renders a styled dropdown submenu trigger.

Generated by `mix flint.add dropdown_sub`. Theming lives in `flint.css`; this
wrapper adds the `data-dropdown_sub` marker the theme targets and renders the
`menu` reference and label. Headless behavior comes from
`FlintUI.dropdown_sub`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.dropdown_sub data-dropdown_sub class={@class} {@rest}>
    {render_slot(@inner_block)}
  </FlintUI.dropdown_sub>
  """
end
