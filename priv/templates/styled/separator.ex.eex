@doc """
Renders a styled separator.

Generated by `mix flint.add separator`. Theming lives in `flint.css`; this
wrapper maps `type`, `variant`, `position`, `size`, and `color` onto the
matching `data-*` hooks, with a numeric `size` converted from pixels to rem.
`label` and `icon` are content shortcuts; the default slot wins over both, and
`label` wins over `icon`. `as`, `orientation`, and `decorative` are forwarded
to the headless component. Headless behavior comes from `FlintUI.separator`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  assigns =
    assigns
    |> assign(:data_size, FlintUI.Styled.Size.scale(assigns.size))
    |> assign(
      :rest,
      FlintUI.Styled.Size.put_style(
        assigns.rest,
        FlintUI.Styled.Size.style(assigns.size, "--fl-separator-size")
      )
    )

  ~H"""
  <FlintUI.separator
    data-separator
    data-type={@type}
    data-variant={@variant}
    data-position={@position}
    data-size={@data_size}
    data-color={@data_color}
    class={@class}
    {@rest}
  >
    {render_slot(@inner_block) || @label}
    <FlintUI.icon :if={@icon && is_nil(@label) && @inner_block == []} name={@icon} />
  </FlintUI.separator>
  """
end
