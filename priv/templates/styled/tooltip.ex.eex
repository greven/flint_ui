@doc """
Renders a styled tooltip.

Generated by `mix flint.add tooltip`. Theming lives in `flint.css`; this
wrapper adds the `data-tooltip` presence hook the styles target. Headless
behavior comes from `FlintUI.tooltip`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.tooltip class={@class} data-tooltip {@rest}>
    {render_slot(@inner_block)}
    <:content>{render_slot(@content)}</:content>
  </FlintUI.tooltip>
  """
end
