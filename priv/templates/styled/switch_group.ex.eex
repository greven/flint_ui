@doc """
Renders a styled switch group.

Generated by `mix flint.add switch_group`. Theming lives in `flint.css`; this
wrapper maps `orientation` onto the group root and forwards `size` and `color` to
every nested switch. The `:switch` slots keep their own `field`, `name`, `value`,
`checked`, `label`, `sublabel`, `description`, `disabled`, and `class`. The group
does not submit a value itself; bind one field per switch. Headless behavior
comes from `FlintUI.switch_group`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    FlintUI.Styled.Color.apply_style(
      assigns,
      ~w(neutral info success warning error primary secondary),
      fill: "--fl-switch-color",
      on_fill: "--fl-switch-color-content"
    )

  root_attrs =
    %{
      "data-switch_group" => true,
      "data-orientation" => assigns.orientation
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false end)
    |> Map.new()

  item_attrs =
    %{
      "data-switch" => true,
      "data-size" => assigns.size,
      "data-color" => assigns.data_color,
      "style" => assigns.color_style
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false end)
    |> Map.new()

  assigns =
    assigns
    |> assign(:root_attrs, root_attrs)
    |> assign(:item_attrs, item_attrs)

  ~H"""
  <FlintUI.switch_group
    root_attrs={@root_attrs}
    item_attrs={@item_attrs}
    class={@class}
    {@rest}
  >
    <:switch
      :for={item <- @switch}
      :if={Map.get(item, :inner_block)}
      field={Map.get(item, :field)}
      name={Map.get(item, :name)}
      id={Map.get(item, :id)}
      value={Map.get(item, :value)}
      checked={Map.get(item, :checked)}
      label={Map.get(item, :label)}
      sublabel={Map.get(item, :sublabel)}
      description={Map.get(item, :description)}
      disabled={Map.get(item, :disabled, false)}
      class={Map.get(item, :class)}
    >
      {render_slot(item)}
    </:switch>
    <:switch
      :for={item <- @switch}
      :if={!Map.get(item, :inner_block)}
      field={Map.get(item, :field)}
      name={Map.get(item, :name)}
      id={Map.get(item, :id)}
      value={Map.get(item, :value)}
      checked={Map.get(item, :checked)}
      label={Map.get(item, :label)}
      sublabel={Map.get(item, :sublabel)}
      description={Map.get(item, :description)}
      disabled={Map.get(item, :disabled, false)}
      class={Map.get(item, :class)}
    />
  </FlintUI.switch_group>
  """
end
