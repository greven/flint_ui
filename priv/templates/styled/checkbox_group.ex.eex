@doc """
Renders a styled checkbox group.

Generated by `mix flint.add checkbox_group`. Theming lives in `flint.css`; this
wrapper maps `orientation` and `variant` onto the group root and forwards
`variant`, `size`, and `radius` to every nested checkbox. The `:checkbox` slots
keep their own `value`, `label`, `sublabel`, `hint`, `disabled`,
`checked`, and `class`. Headless behavior comes from `FlintUI.checkbox_group`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  root_attrs =
    %{
      "data-checkbox_group" => true,
      "data-orientation" => assigns.orientation,
      "data-variant" => assigns.variant
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false end)
    |> Map.new()

  item_attrs =
    %{
      "data-checkbox" => true,
      "data-variant" => assigns.variant,
      "data-size" => assigns.size,
      "data-radius" => assigns.radius
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false end)
    |> Map.new()

  assigns =
    assigns
    |> assign(:root_attrs, root_attrs)
    |> assign(:item_attrs, item_attrs)

  ~H"""
  <FlintUI.checkbox_group
    root_attrs={@root_attrs}
    item_attrs={@item_attrs}
    class={@class}
    {@rest}
  >
    <:checkbox
      :for={item <- @checkbox}
      :if={Map.get(item, :inner_block)}
      value={item.value}
      label={Map.get(item, :label)}
      sublabel={Map.get(item, :sublabel)}
      hint={Map.get(item, :hint)}
      disabled={Map.get(item, :disabled, false)}
      checked={Map.get(item, :checked)}
      class={Map.get(item, :class)}
    >
      {render_slot(item)}
    </:checkbox>
    <:checkbox
      :for={item <- @checkbox}
      :if={!Map.get(item, :inner_block)}
      value={item.value}
      label={Map.get(item, :label)}
      sublabel={Map.get(item, :sublabel)}
      hint={Map.get(item, :hint)}
      disabled={Map.get(item, :disabled, false)}
      checked={Map.get(item, :checked)}
      class={Map.get(item, :class)}
    />
  </FlintUI.checkbox_group>
  """
end
