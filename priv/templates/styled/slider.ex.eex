@doc """
Renders a styled slider.

Generated by `mix flint.add slider`. Theming lives in `flint.css`; this
wrapper maps `size` and `color` onto the field root, writes a raw color to the
root's CSS inputs, and forwards `name`, `label`, `sublabel`, `description`,
`hint`, `value`, `range`, `orientation`, and the rest of the
`FlintUI.slider` contract. A caller `style` also lands on the field root, so a
slider can be sized without touching the native inputs. Headless behavior comes
from `FlintUI.slider`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    FlintUI.Styled.Color.apply_style(
      assigns,
      ~w(neutral info success warning danger primary secondary),
      fill: "--fl-slider-color"
    )

  {rest_style, rest} = Map.pop(assigns.rest, :style)

  style =
    [assigns.color_style, rest_style]
    |> Enum.reject(&(&1 in [nil, ""]))
    |> Enum.join("; ")

  root_attrs =
    %{
      "data-slider" => true,
      "data-size" => assigns.size,
      "data-color" => assigns.data_color,
      "style" => style
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false or value == "" end)
    |> Map.new()

  assigns =
    assigns
    |> assign(:root_attrs, root_attrs)
    |> assign(:rest, rest)

  ~H"""
  <FlintUI.slider root_attrs={@root_attrs} class={@class} {@rest} />
  """
end
