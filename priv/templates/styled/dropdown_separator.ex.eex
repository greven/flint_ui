@doc """
Renders a styled dropdown separator.

Generated by `mix flint.add dropdown_separator`. Theming lives in `flint.css`;
this wrapper adds the `data-dropdown_separator` marker the theme targets.
Headless behavior comes from `FlintUI.dropdown_separator`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.dropdown_separator data-dropdown_separator class={@class} {@rest} />
  """
end
