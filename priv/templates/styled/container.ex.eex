@doc """
Renders a styled container.

Generated by `mix flint.add container`. Theming lives in `flint.css`; this
wrapper centers its content, caps the inline size from `size`, and adds inline
padding. `size` accepts a container token from `xs` to `7xl`, `fluid`, a number
of pixels converted to rem, an arbitrary CSS length, or a map of breakpoint
overrides. `as` is forwarded to the headless component. Headless structure comes
from `FlintUI.container`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  {data_size, container_style} = FlintUI.Styled.ContainerSize.resolve(assigns.size)

  assigns =
    assigns
    |> assign(:data_size, data_size)
    |> assign(:rest, FlintUI.Styled.Size.put_style(assigns.rest, container_style))

  ~H"""
  <FlintUI.container
    data-container
    data-size={@data_size}
    class={@class}
    {@rest}
  >
    {render_slot(@inner_block)}
  </FlintUI.container>
  """
end
