@doc """
Renders a styled popover.

Generated by `mix flint.add popover`. Theming lives in `flint.css`; this
wrapper adds the `data-popover` presence hook the styles target. Headless
behavior comes from `FlintUI.popover`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.popover class={@class} data-popover {@rest}>
    {render_slot(@inner_block)}
    <:content>{render_slot(@content)}</:content>
  </FlintUI.popover>
  """
end
