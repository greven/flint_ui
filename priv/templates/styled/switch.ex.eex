@doc """
Renders a styled switch.

Generated by `mix flint.add switch`. Theming lives in `flint.css`; this
wrapper maps `size` and `color` onto the switch root, writes a raw color to the
root's CSS inputs, and forwards `name`, `label`, `sublabel`, `description`, `checked`,
and the rest of the `FlintUI.switch` contract. The `:on` and `:off` slots render
decorative text inside the track for that state; the theme hides the inactive
one. Headless behavior comes from `FlintUI.switch`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    FlintUI.Styled.Color.apply_style(
      assigns,
      ~w(neutral info success warning error primary secondary),
      fill: "--fl-switch-color",
      on_fill: "--fl-switch-color-content"
    )

  root_attrs =
    %{
      "data-switch" => true,
      "data-size" => assigns.size,
      "data-color" => assigns.data_color,
      "style" => assigns.color_style
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false end)
    |> Map.new()

  assigns = assign(assigns, :root_attrs, root_attrs)

  ~H"""
  <FlintUI.switch
    root_attrs={@root_attrs}
    label_content={@inner_block not in [nil, []] && render_slot(@inner_block)}
    class={@class}
    {@rest}
  >
    <:on :if={@on != []}>{render_slot(@on)}</:on>
    <:off :if={@off != []}>{render_slot(@off)}</:off>
  </FlintUI.switch>
  """
end
