@doc """
Renders a styled accordion.

Generated by `mix flint.add accordion`. Theming lives in `flint.css`; this
wrapper maps `variant`, `surface`, `indicator_position`, and `transition` onto
the matching `data-*` hooks and writes the `duration` prop as the reveal
duration. Headless behavior comes from `FlintUI.accordion`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  {rest_style, rest} = Map.pop(assigns.rest, :style)

  duration_style =
    if assigns.duration, do: "--fl-accordion-duration: #{assigns.duration}ms"

  style =
    [duration_style, rest_style]
    |> Enum.reject(&is_nil/1)
    |> Enum.map_join("; ", fn
      value when is_list(value) -> Enum.map_join(value, "; ", &IO.iodata_to_binary/1)
      value -> IO.iodata_to_binary(value)
    end)

  assigns =
    assigns
    |> assign(:rest, rest)
    |> assign(:style, if(style == "", do: nil, else: style))

  ~H"""
  <FlintUI.accordion
    data-accordion
    data-variant={@variant}
    data-surface={@surface}
    data-indicator-position={@indicator_position}
    data-transition={@transition}
    class={@class}
    style={@style}
    {@rest}
  >
    {render_slot(@inner_block)}
  </FlintUI.accordion>
  """
end
