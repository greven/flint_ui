@doc """
Renders a styled icon.

Generated by `mix flint.add icon`. Theming lives in `flint.css`; this wrapper
maps the `size` attribute onto the `data-size` hook the theme targets, with a
numeric `size` converted from pixels to rem. Headless behavior comes from
`FlintUI.icon`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    assigns
    |> assign(:data_size, FlintUI.Styled.Size.scale(assigns.size))
    |> assign(
      :rest,
      FlintUI.Styled.Size.put_style(
        assigns.rest,
        FlintUI.Styled.Size.style(assigns.size, "--fl-icon-size")
      )
    )

  ~H"""
  <FlintUI.icon
    data-icon
    data-size={@data_size}
    class={@class}
    {@rest}
  />
  """
end
