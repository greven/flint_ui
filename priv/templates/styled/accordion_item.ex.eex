@doc """
Renders a styled accordion item.

Generated by `mix flint.add accordion_item`. Theming lives in `flint.css`; this
wrapper adds the `data-accordion_item` marker the theme targets and forwards the
header, indicator, and panel slots. Headless behavior comes from
`FlintUI.accordion_item`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.accordion_item
    data-accordion_item
    class={@class}
    {@rest}
  >
    <:header :for={header <- @header} {Map.drop(header, [:inner_block, :__slot__])}>
      {render_slot(header)}
    </:header>
    <:indicator :for={indicator <- @indicator} {Map.drop(indicator, [:inner_block, :__slot__])}>
      {render_slot(indicator)}
    </:indicator>
    <:panel :for={panel <- @panel} class={Map.get(panel, :class)}>
      {render_slot(panel)}
    </:panel>
  </FlintUI.accordion_item>
  """
end
