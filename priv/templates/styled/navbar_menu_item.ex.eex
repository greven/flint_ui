@doc """
Renders a styled navbar menu item.

Generated by `mix flint.add navbar_menu_item`. Theming lives in `flint.css`;
this wrapper adds the `data-navbar_menu_item` marker the theme targets, renders
the optional leading and trailing icons, and falls back to `text` when the
default slot is empty. Headless link and active behavior comes from
`FlintUI.navbar_menu_item`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.navbar_menu_item data-navbar_menu_item class={@class} {@rest}>
    {render_slot(@leading)}
    <FlintUI.icon :if={@icon} name={@icon} />
    {render_slot(@inner_block) || @text}
    {render_slot(@trailing)}
    <FlintUI.icon :if={@trailing_icon} name={@trailing_icon} />
  </FlintUI.navbar_menu_item>
  """
end
