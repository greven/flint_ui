@doc """
Renders a styled radio.

Generated by `mix flint.add radio`. Theming lives in `flint.css`; this wrapper
maps `variant`, `size`, `radius`, and `color` onto the radio root, writes a raw
color to the root's CSS inputs, and forwards `name`, `value`, `label`,
`sublabel`, `hint`, `checked`, and the rest of the `FlintUI.radio`
contract. Headless behavior comes from `FlintUI.radio`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    FlintUI.Styled.Color.apply_style(
      assigns,
      ~w(neutral info success warning error primary secondary),
      fill: "--fl-radio-color",
      on_fill: "--fl-radio-color-content"
    )

  root_attrs =
    %{
      "data-radio" => true,
      "data-variant" => assigns.variant,
      "data-size" => assigns.size,
      "data-radius" => assigns.radius,
      "data-color" => assigns.data_color,
      "style" => assigns.color_style
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false end)
    |> Map.new()

  assigns = assign(assigns, :root_attrs, root_attrs)

  ~H"""
  <FlintUI.radio
    root_attrs={@root_attrs}
    label_content={@inner_block not in [nil, []] && render_slot(@inner_block)}
    class={@class}
    {@rest}
  />
  """
end
