@doc """
Renders a styled keyboard key.

Generated by `mix flint.add kbd`. Theming lives in `flint.css`; this wrapper
maps the `variant` and `size` attributes onto the `data-variant` and `data-size`
hooks the theme targets. Headless behavior comes from `FlintUI.kbd`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.kbd
    data-kbd
    data-variant={@variant}
    data-size={@size}
    class={@class}
    {@rest}
  >
    {render_slot(@inner_block)}
  </FlintUI.kbd>
  """
end
