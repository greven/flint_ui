@doc """
Renders a styled copy button.

Generated by `mix flint.add copy_button`. Theming lives in `flint.css`; this
wrapper maps `size` onto the control scale, adds the `data-copy_button` marker
the theme targets, and forwards the headless `value`, `from`, `attribute`,
`property`, `label`, `success_label`, `error_label`, `feedback_duration`, and
`disabled` attributes. `icon`, `success_icon`, and `error_icon` replace the
decorative state icons; the default slot adds visible text. The `:success` and
`:error` slots add content beside the state icon; set the matching icon to an
empty string to omit it. Headless behavior comes from `FlintUI.copy_button`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.copy_button
    data-copy_button
    data-size={@size}
    data-square={@inner_block == []}
    class={@class}
    {@rest}
  >
    <FlintUI.icon :if={@icon not in [nil, ""]} name={@icon} />
    {render_slot(@inner_block)}
    <:success :if={@success_icon not in [nil, ""] or @success != []}>
      <FlintUI.icon :if={@success_icon not in [nil, ""]} name={@success_icon} />
      {render_slot(@success)}
    </:success>
    <:error :if={@error_icon not in [nil, ""] or @error != []}>
      <FlintUI.icon :if={@error_icon not in [nil, ""]} name={@error_icon} />
      {render_slot(@error)}
    </:error>
  </FlintUI.copy_button>
  """
end
