@doc """
Renders a styled copy button.

Generated by `mix flint.add copy_button`. Theming lives in `flint.css`; this
wrapper opts into the shared control primitive and maps `variant`, `dashed`,
`color`, `success_color`, `size`, `radius`, `pill`, `square`, `wide`, `justify`,
`depth`, and `inset` onto the same hooks a button uses. `icon`, `text`,
`success_icon`, and `error_icon` fill the copy states; the default slot wins over
`text`, and `text` becomes the accessible name when `label` is omitted. The
`:success` and `:error` slots add content beside the state icon.
`success_color` recolors the control while the success state is visible.
`tooltip` wraps the button in a tooltip that follows the copy state, which is
most useful for an icon-only button. Headless behavior comes from
`FlintUI.copy_button`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  tooltip_placement =
    if is_binary(assigns.tooltip) and assigns.tooltip != "", do: assigns.tooltip, else: "top"

  assigns =
    assigns
    |> assign(:show_tooltip, assigns.tooltip not in [nil, false])
    |> assign(:tooltip_placement, tooltip_placement)
    |> assign(:tooltip_success_label, Map.get(assigns.rest, :success_label) || "Copied")
    |> assign(:tooltip_error_label, Map.get(assigns.rest, :error_label) || "Copy failed")

  ~H"""
  <%% inner = render_slot(@inner_block) %>
  <%% blank = copy_button_blank?(inner) %>
  <%% text? = not copy_button_blank?(@text) %>
  <%% label =
    Map.get(@rest, :label) ||
      Map.get(@rest, :"aria-label") ||
      if(blank and text?, do: @text, else: "Copy")
  %>
  <%% square = @square or (blank and not text?) %>
  <FlintUI.tooltip
    :if={@show_tooltip}
    data-tooltip
    data-copy-tooltip
    placement={@tooltip_placement}
  >
    <FlintUI.copy_button
      data-copy_button
      data-control
      data-variant={@variant}
      data-dashed={@dashed}
      data-color={@data_color}
      data-success-color={if @success_color == "inherit", do: nil, else: @success_color}
      data-size={@size}
      data-radius={@radius}
      data-pill={@pill}
      data-square={square}
      data-wide={@wide}
      data-justify={@justify}
      data-depth={@depth}
      data-inset={@inset}
      label={label}
      class={@class}
      {@rest}
    >
      <FlintUI.icon :if={@icon not in [nil, ""]} name={@icon} />
      {if blank, do: @text, else: inner}
      <:success :if={@success_icon not in [nil, ""] or @success != []}>
        <FlintUI.icon :if={@success_icon not in [nil, ""]} name={@success_icon} />
        {render_slot(@success)}
      </:success>
      <:error :if={@error_icon not in [nil, ""] or @error != []}>
        <FlintUI.icon :if={@error_icon not in [nil, ""]} name={@error_icon} />
        {render_slot(@error)}
      </:error>
    </FlintUI.copy_button>
    <:content>
      <span data-copy-tooltip-text="idle">{label}</span>
      <span data-copy-tooltip-text="success">{@tooltip_success_label}</span>
      <span data-copy-tooltip-text="error">{@tooltip_error_label}</span>
    </:content>
  </FlintUI.tooltip>
  <FlintUI.copy_button
    :if={not @show_tooltip}
    data-copy_button
    data-control
    data-variant={@variant}
    data-dashed={@dashed}
    data-color={@data_color}
    data-success-color={if @success_color == "inherit", do: nil, else: @success_color}
    data-size={@size}
    data-radius={@radius}
    data-pill={@pill}
    data-square={square}
    data-wide={@wide}
    data-justify={@justify}
    data-depth={@depth}
    data-inset={@inset}
    label={label}
    class={@class}
    {@rest}
  >
    <FlintUI.icon :if={@icon not in [nil, ""]} name={@icon} />
    {if blank, do: @text, else: inner}
    <:success :if={@success_icon not in [nil, ""] or @success != []}>
      <FlintUI.icon :if={@success_icon not in [nil, ""]} name={@success_icon} />
      {render_slot(@success)}
    </:success>
    <:error :if={@error_icon not in [nil, ""] or @error != []}>
      <FlintUI.icon :if={@error_icon not in [nil, ""]} name={@error_icon} />
      {render_slot(@error)}
    </:error>
  </FlintUI.copy_button>
  """
end

# `text` stands in for the default slot only when that slot has no visible
# content. A component body with only whitespace (as happens when a caller
# passes just a named slot) renders as whitespace, so compare the rendered
# content instead of the slot list.
defp copy_button_blank?(nil), do: true
defp copy_button_blank?(""), do: true
defp copy_button_blank?(value) when is_binary(value), do: String.trim(value) == ""

defp copy_button_blank?(value) when is_list(value) do
  value |> IO.iodata_to_binary() |> String.trim() == ""
end

defp copy_button_blank?(value) do
  value
  |> Phoenix.HTML.Safe.to_iodata()
  |> IO.iodata_to_binary()
  |> String.trim() == ""
rescue
  _ -> false
end
