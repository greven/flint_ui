@doc """
Renders a styled copy button.

Generated by `mix flint.add copy_button`. Theming lives in `flint.css`; this
wrapper opts into the shared control primitive and maps `variant`, `dashed`,
`color`, `size`, `radius`, `pill`, `square`, `wide`, `justify`, `depth`, and
`inset` onto the same hooks a button uses. `icon`, `text`, `success_icon`, and
`error_icon` fill the copy states; the default slot wins over `text`, and the
`:success` and `:error` slots add content beside the state icon. Headless
behavior comes from `FlintUI.copy_button`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
<%= @color %>
  ~H"""
  <FlintUI.copy_button
    data-copy_button
    data-control
    data-variant={@variant}
    data-dashed={@dashed}
    data-color={@data_color}
    data-size={@size}
    data-radius={@radius}
    data-pill={@pill}
    data-square={@square or (@inner_block == [] and @text in [nil, ""])}
    data-wide={@wide}
    data-justify={@justify}
    data-depth={@depth}
    data-inset={@inset}
    class={@class}
    {@rest}
  >
    <FlintUI.icon :if={@icon not in [nil, ""]} name={@icon} />
    {render_slot(@inner_block) || @text}
    <:success :if={@success_icon not in [nil, ""] or @success != []}>
      <FlintUI.icon :if={@success_icon not in [nil, ""]} name={@success_icon} />
      {render_slot(@success)}
    </:success>
    <:error :if={@error_icon not in [nil, ""] or @error != []}>
      <FlintUI.icon :if={@error_icon not in [nil, ""]} name={@error_icon} />
      {render_slot(@error)}
    </:error>
  </FlintUI.copy_button>
  """
end
