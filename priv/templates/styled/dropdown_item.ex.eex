@doc """
Renders a styled dropdown item.

Generated by `mix flint.add dropdown_item`. Theming lives in `flint.css`; this
wrapper adds the `data-dropdown_item` marker the theme targets, renders the
optional `icon` before the content, and falls back to `text` when the default
slot is empty. Headless behavior comes from `FlintUI.dropdown_item`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.dropdown_item data-dropdown_item class={@class} {@rest}>
    <FlintUI.icon :if={@icon} name={@icon} />
    {render_slot(@inner_block) || @text}
  </FlintUI.dropdown_item>
  """
end
