@doc """
Renders a styled progress bar.

Generated by `mix flint.add progress`. Theming lives in `flint.css`; this
wrapper maps `size`, `color`, `radius`, `striped`, `animated`, and
`indeterminate` onto the progress root, writes a raw color to the root's CSS
inputs, and forwards `value`, `max`, `label`, `orientation`, `show_status`, and
the rest of the `FlintUI.progress` contract. A caller `style` also lands on the
root, so a vertical bar can be given a height without touching the track.
Headless behavior comes from `FlintUI.progress`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  assigns =
    FlintUI.Styled.Color.apply_style(
      assigns,
      ~w(neutral info success warning error primary secondary),
      fill: "--fl-progress-color"
    )

  {rest_style, rest} = Map.pop(assigns.rest, :style)

  style =
    [assigns.color_style, rest_style]
    |> Enum.reject(&(&1 in [nil, ""]))
    |> Enum.join("; ")

  root_attrs =
    %{
      "data-progress" => true,
      "data-size" => assigns.size,
      "data-color" => assigns.data_color,
      "data-radius" => assigns.radius,
      "data-indeterminate" => assigns.indeterminate,
      "data-striped" => assigns.striped,
      "data-animated" => assigns.animated,
      "style" => style
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) or value == false or value == "" end)
    |> Map.new()

  assigns =
    assigns
    |> assign(:root_attrs, root_attrs)
    |> assign(:rest, rest)

  ~H"""
  <FlintUI.progress root_attrs={@root_attrs} class={@class} {@rest} />
  """
end
