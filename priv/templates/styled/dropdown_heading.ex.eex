@doc """
Renders a styled dropdown heading.

Generated by `mix flint.add dropdown_heading`. Theming lives in `flint.css`;
this wrapper adds the `data-dropdown_heading` marker the theme targets. Headless
behavior comes from `FlintUI.dropdown_heading`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.dropdown_heading data-dropdown_heading class={@class} {@rest}>
    {render_slot(@inner_block)}
  </FlintUI.dropdown_heading>
  """
end
