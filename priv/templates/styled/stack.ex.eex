@doc """
Renders a styled stack.

Generated by `mix flint.add stack`. Theming lives in `flint.css`; this wrapper
maps `align`, `gap`, `justify`, `pile`, `limit`, `direction`, and `shrink` onto
the matching `data-*` hooks the theme targets. The defaults are
`align="stretch"`, `gap="md"`, `justify="start"`, `limit="3"`,
`direction="up"`, and `shrink="sm"`, with `pile` off. `as` is forwarded to the
headless component. Headless structure comes from `FlintUI.stack`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.stack
    data-stack
    data-align={@align}
    data-gap={@gap}
    data-justify={@justify}
    data-pile={@pile}
    data-limit={@limit}
    data-direction={@direction}
    data-shrink={@shrink}
    class={@class}
    {@rest}
  >
    {render_slot(@inner_block)}
  </FlintUI.stack>
  """
end
