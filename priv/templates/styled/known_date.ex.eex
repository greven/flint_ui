@doc """
Renders a styled known date.

Generated by `mix flint.add known_date`. Theming lives in `flint.css`; this
wrapper maps `size` and `radius` onto the group root and forwards the rest of
the `FlintUI.known_date` contract, including `field`, `label`, `sublabel`,
`description`, `hint`, `locale`, `min`, `max`, `required`, and the canonical ISO
`value`. Headless behavior comes from `FlintUI.known_date`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  root_attrs =
    %{
      "data-known_date" => true,
      "data-field" => true,
      "data-size" => FlintUI.Styled.Size.scale(assigns.size),
      "data-radius" => assigns.radius
    }
    |> Enum.reject(fn {_key, value} -> is_nil(value) end)
    |> Map.new()

  assigns = assign(assigns, :root_attrs, root_attrs)

  ~H"""
  <FlintUI.known_date root_attrs={@root_attrs} class={@class} {@rest} />
  """
end
