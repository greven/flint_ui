@doc """
Renders a styled card.

Generated by `mix flint.add card`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `body`, `spacing`, `outline`, `shadow`, `inverted`, and
`indicator` attributes onto the matching `data-*` hooks the theme targets, and
forwards `as`, `orientation`, `padded`, `title_id`, `title_as`, `description_id`,
and the link attributes to the headless component. A linked card with `indicator`
gets a corner arrow from `indicator_icon`, which defaults to
`lucide-arrow-up-right`. Headless behavior comes from `FlintUI.card`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  indicator = assigns.indicator and card_link?(assigns.rest)

  show_indicator_icon =
    indicator and is_binary(assigns.indicator_icon) and assigns.indicator_icon != ""

  assigns =
    assigns
    |> assign(:indicator, indicator)
    |> assign(:show_indicator_icon, show_indicator_icon)

  ~H"""
  <FlintUI.card
    data-card
    data-elevation
    data-indicator={@indicator}
    data-variant={@variant}
    data-body={@body}
    data-spacing={@spacing}
    data-outline={@outline}
    data-shadow={@shadow}
    data-inverted={@inverted}
    class={@class}
    {@rest}
  >
    <:corner :if={@show_indicator_icon or @corner != []}>
      {render_slot(@corner)}
      <FlintUI.icon :if={@show_indicator_icon} name={@indicator_icon} />
    </:corner>
    <:title>{render_slot(@title)}</:title>
    <:description>{render_slot(@description)}</:description>
    <:header_actions>{render_slot(@header_actions)}</:header_actions>
    <:header>{render_slot(@header)}</:header>
    {render_slot(@inner_block)}
    <:section :for={section <- @section}>
      {render_slot(section)}
    </:section>
    <:footer>{render_slot(@footer)}</:footer>
    <:footer_actions>{render_slot(@footer_actions)}</:footer_actions>
  </FlintUI.card>
  """
end

defp card_link?(rest), do: not is_nil(rest[:href] || rest[:navigate] || rest[:patch])
