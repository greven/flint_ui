@doc """
Renders a styled card.

Generated by `mix flint.add card`. Theming lives in `flint.css`; this wrapper
maps the `variant`, `size`, and `divided` attributes onto the `data-variant`,
`data-size`, and `data-divided` hooks the theme targets. Headless behavior comes
from `FlintUI.card`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.card
    data-card
    data-variant={@variant}
    data-size={@size}
    data-divided={to_string(@divided)}
    class={@class}
    {@rest}
  >
    <:title>{render_slot(@title)}</:title>
    <:description>{render_slot(@description)}</:description>
    <:action>{render_slot(@action)}</:action>
    <:header>{render_slot(@header)}</:header>
    {render_slot(@inner_block)}
    <:footer>{render_slot(@footer)}</:footer>
  </FlintUI.card>
  """
end
