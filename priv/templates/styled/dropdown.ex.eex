@doc """
Renders a styled dropdown menu.

Generated by `mix flint.add dropdown`. Theming lives in `flint.css`; this
wrapper adds the `data-dropdown` presence hook the styles target and forwards
the trigger and submenu slots. Headless behavior comes from
`FlintUI.dropdown`.
"""
<%= @attrs %>
<%= @slots %>

def <%= @name %>(assigns) do
  ~H"""
  <FlintUI.dropdown data-dropdown class={@class} {@rest}>
    {render_slot(@inner_block)}
    <:trigger :for={trigger <- @trigger} :let={attrs}>
      {render_slot(trigger, attrs)}
    </:trigger>
    <:submenu :for={submenu <- @submenu} id={Map.get(submenu, :id)}>
      {render_slot(submenu)}
    </:submenu>
  </FlintUI.dropdown>
  """
end
