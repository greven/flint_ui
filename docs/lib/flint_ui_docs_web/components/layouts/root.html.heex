<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="FlintUIDocs" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={asset_path(~p"/assets/css/app.css")} />
    <script defer phx-track-static type="text/javascript" src={asset_path(~p"/assets/js/app.js")}>
    </script>
    <script>
      (() => {
        const setScheme = (scheme) => {
          if (scheme === "system") {
            localStorage.removeItem("phx:scheme");
            document.documentElement.removeAttribute("data-color-scheme");
          } else {
            localStorage.setItem("phx:scheme", scheme);
            document.documentElement.setAttribute("data-color-scheme", scheme);
          }
        };
        const setPreset = (preset) => {
          if (!preset || preset === "default") {
            localStorage.removeItem("phx:preset");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:preset", preset);
            document.documentElement.setAttribute("data-theme", preset);
          }
        };
        if (!document.documentElement.hasAttribute("data-color-scheme")) {
          setScheme(localStorage.getItem("phx:scheme") || "system");
        }
        if (!document.documentElement.hasAttribute("data-theme")) {
          setPreset(localStorage.getItem("phx:preset") || "default");
        }
        window.addEventListener("storage", (e) => {
          if (e.key === "phx:scheme") setScheme(e.newValue || "system");
          if (e.key === "phx:preset") setPreset(e.newValue || "default");
        });

        window.addEventListener("phx:set-scheme", (e) => setScheme(e.target.dataset.phxScheme));
        window.addEventListener("phx:set-preset", (e) => setPreset(e.target.dataset.phxPreset));
      })();
    </script>
  </head>
  <body class="bg-default text-default">
    {@inner_content}
  </body>
</html>
